# --- MySQL ---
MYSQL_DATABASE=appprestamos
MYSQL_USER=prestamos
MYSQL_PASSWORD=cambia-esto
MYSQL_ROOT_PASSWORD=cambia-esto-root

# --- API ---
# Dentro del contenedor api se usa: mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/${MYSQL_DATABASE}
DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/${MYSQL_DATABASE}
API_PORT=3000
JWT_ACCESS_SECRET=cambia-esto-access
JWT_REFRESH_SECRET=cambia-esto-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
ADMIN_PHONE=admin
ADMIN_PASSWORD=admin
TZ=America/Mexico_City

# --- Email (Gmail SMTP) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=documentos
# Endpoint que puede resolver el NAVEGADOR del cliente para las URLs firmadas
# (el endpoint interno "minio" solo es resoluble dentro de la red de Docker).
# Dev: localhost:9000 (puerto publicado en docker-compose.dev.yml).
# Prod: dominio público real de MinIO (o el proxy de Nginx que lo exponga) —
# MinIO no está expuesto a internet en docker-compose.prod.yml todavía,
# hace falta un reverse-proxy antes de que las URLs firmadas funcionen en prod.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000