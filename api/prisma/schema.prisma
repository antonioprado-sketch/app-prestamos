generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  phone              String   @id @db.VarChar(15)
  email              String?  @unique @db.VarChar(190)
  passwordHash       String   @map("password_hash") @db.VarChar(255)
  role               Role     @default(CLIENT)
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  failedAttempts     Int      @default(0) @map("failed_attempts")
  blockedUntil       DateTime? @map("blocked_until") @db.DateTime(6)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  customer    Customer?
  collector   Collector?
  admin       Admin?
  refreshTokens RefreshToken[]
  auditLogs   AuditLog[]
  approvedLoans Loan[] @relation("LoanApprover")
  notifications Notification[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  userPhone String   @map("user_phone") @db.VarChar(15)
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ip        String?  @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userPhone], references: [phone], onDelete: Cascade)

  @@index([userPhone])
  @@map("refresh_tokens")
}

model Customer {
  phone              String   @id @db.VarChar(15)
  nombres            String?  @db.VarChar(25)
  apellidos          String?  @db.VarChar(35)
  aval               String?  @db.VarChar(70)
  avalPhone          String?  @map("aval_phone") @db.VarChar(15)
  email              String?  @db.VarChar(190)
  calle              String?
  numero             String?
  colonia            String?
  cp                 String?  @db.VarChar(5)
  ciudad             String?
  estado             String?
  referencias        String?  @db.VarChar(255)
  isNewCustomer      Boolean     @default(false) @map("is_new_customer")
  onboardingComplete Boolean     @default(false) @map("onboarding_complete")
  scoreOverride      ScoreLevel? @map("score_override")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [phone], references: [phone], onDelete: Cascade)
  loans Loan[]
  documents Document[]
  locations Location[]

  @@map("customers")
}

model Collector {
  id        BigInt  @id @default(autoincrement())
  phone     String  @unique @db.VarChar(15)
  name      String  @db.VarChar(70)
  active    Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [phone], references: [phone], onDelete: Cascade)
  loans Loan[]

  @@map("collectors")
}

model Admin {
  id        BigInt  @id @default(autoincrement())
  phone     String  @unique @db.VarChar(15)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [phone], references: [phone], onDelete: Cascade)

  @@map("admins")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userPhone String?  @map("user_phone") @db.VarChar(15)
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.VarChar(100)
  prevValue Json?    @map("prev_value")
  newValue  Json?    @map("new_value")
  ip        String?  @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userPhone], references: [phone], onDelete: SetNull)

  @@index([userPhone])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Loan {
  id            BigInt     @id @default(autoincrement())
  folio         String     @unique @db.VarChar(9)
  customerPhone String     @map("customer_phone") @db.VarChar(15)
  collectorId   BigInt?    @map("collector_id")
  amount        Decimal    @db.Decimal(10, 2)
  totalToPay    Decimal    @map("total_to_pay") @db.Decimal(10, 2)
  model         LoanModel
  status        LoanStatus @default(DRAFT)
  openingDate   DateTime   @map("opening_date") @db.Date
  approvedBy    String?    @map("approved_by") @db.VarChar(15)
  approvedAt    DateTime?  @map("approved_at")
  adminNote     String?    @map("admin_note") @db.VarChar(500)
  penaltyPaid   Decimal    @default(0) @map("penalty_paid") @db.Decimal(10, 2)
  liquidatedAt  DateTime?  @map("liquidated_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  customer  Customer       @relation(fields: [customerPhone], references: [phone], onDelete: Cascade)
  collector Collector?     @relation(fields: [collectorId], references: [id], onDelete: SetNull)
  approver  User?          @relation("LoanApprover", fields: [approvedBy], references: [phone], onDelete: SetNull)
  schedule  LoanSchedule[]
  documents Document[]
  payments  Payment[]

  @@index([customerPhone, status])
  @@map("loans")
}

model LoanSchedule {
  id         BigInt         @id @default(autoincrement())
  loanId     BigInt         @map("loan_id")
  seq        Int
  dueDate    DateTime       @map("due_date") @db.Date
  amount     Decimal        @db.Decimal(10, 2)
  status     ScheduleStatus @default(PENDING)
  paidAmount Decimal        @default(0) @map("paid_amount") @db.Decimal(10, 2)

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, seq])
  @@index([loanId, dueDate])
  @@map("loan_schedules")
}

model Document {
  id            BigInt       @id @default(autoincrement())
  customerPhone String       @map("customer_phone") @db.VarChar(15)
  loanId        BigInt?      @map("loan_id")
  type          DocumentType
  storageKey    String       @map("storage_key") @db.VarChar(255)
  mime          String       @db.VarChar(100)
  sizeBytes     Int          @map("size_bytes")
  checksum      String       @db.VarChar(64)
  uploadedBy    String       @map("uploaded_by") @db.VarChar(15)
  createdAt     DateTime     @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerPhone], references: [phone], onDelete: Cascade)
  loan     Loan?    @relation(fields: [loanId], references: [id], onDelete: SetNull)

  @@index([customerPhone, type])
  @@map("documents")
}

model Location {
  id            BigInt         @id @default(autoincrement())
  customerPhone String         @map("customer_phone") @db.VarChar(15)
  lat           Decimal        @db.Decimal(9, 6)
  lng           Decimal        @db.Decimal(9, 6)
  accuracy      Decimal?       @db.Decimal(10, 2)
  source        LocationSource
  capturedAt    DateTime       @default(now()) @map("captured_at")

  customer Customer @relation(fields: [customerPhone], references: [phone], onDelete: Cascade)

  @@index([customerPhone, capturedAt])
  @@map("locations")
}

model Payment {
  id             BigInt   @id @default(autoincrement())
  loanId         BigInt   @map("loan_id")
  amount         Decimal  @db.Decimal(10, 2)
  penaltyApplied Decimal  @default(0) @map("penalty_applied") @db.Decimal(10, 2)
  receivedAt     DateTime @default(now()) @map("received_at")
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(64)
  notes          String?  @db.VarChar(255)
  createdBy      String   @map("created_by") @db.VarChar(15)

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, receivedAt])
  @@map("payments")
}

model Configuration {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedBy String?  @map("updated_by") @db.VarChar(15)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("configuration")
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  userPhone String    @map("user_phone") @db.VarChar(15)
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(150)
  body      String    @db.VarChar(500)
  metadata  Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userPhone], references: [phone], onDelete: Cascade)

  @@index([userPhone, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        BigInt   @id @default(autoincrement())
  userPhone String   @map("user_phone") @db.VarChar(15)
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userPhone], references: [phone], onDelete: Cascade)

  @@index([userPhone])
  @@map("push_subscriptions")
}

enum Role {
  CLIENT
  COLLECTOR
  ADMIN
}

enum ScoreLevel {
  GREEN
  YELLOW
  ORANGE
  RED
}

enum LocationSource {
  ONBOARDING
  LOGIN
  PAYMENT
  REQUEST
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum LoanModel {
  WEEKLY
  BIWEEKLY
}

enum LoanStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  REQUIRES_CORRECTION
  APPROVED
  REJECTED
  ACTIVE
  LIQUIDATED
  CANCELLED
}

enum ScheduleStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
}

enum DocumentType {
  INE_FRONT
  INE_BACK
  ADDRESS_PROOF
  PAGARE
  VIDEO_IDENTITY
  COLLECTOR_DOC
}
